# Copy this file to .env and edit it. The server reads it on start (npm start).

PORT=3000

# Where the database and uploaded product photos are kept. Back this folder up.
DATA_DIR=./data

# Your public web address once the site is online, with no trailing slash.
# Only needed for Stripe and Paystack, so customers come back to the right place.
# BASE_URL=https://www.fricco.example

# Prices are in this currency. Use a 3 letter code such as USD, NGN, GBP, EUR.
CURRENCY=USD
SHIPPING_FLAT=6
FREE_SHIPPING_OVER=100

# none (default: no payment on the site, orders are placed and you arrange payment),
# simulated (test card form, no money moves), stripe or paystack
PAYMENT_PROVIDER=none
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# PAYSTACK_SECRET_KEY=sk_live_...

# The admin account is created the first time the server starts.
# After that, change the password inside the dashboard (Security tab); these two are then ignored.
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=admin

# Set these when the site is served over https (most hosts do this for you).
# NODE_ENV=production
# TRUST_PROXY=true

# Stripe: set the webhook to https://YOUR-SITE/api/webhooks/stripe (event checkout.session.completed).
# Paystack: set the webhook to https://YOUR-SITE/api/webhooks/paystack.
